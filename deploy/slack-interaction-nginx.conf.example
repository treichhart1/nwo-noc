# Separately approved HTTPS callback vhost only. Never proxy private NOC routes.
# http{}: limit_req_zone $binary_remote_addr zone=noc_slack_callbacks:10m rate=5r/s;
location = /callbacks/slack/interactions {
    limit_except POST { deny all; }
    limit_req zone=noc_slack_callbacks burst=10 nodelay;
    client_max_body_size 16k;
    client_body_timeout 2s;
    proxy_connect_timeout 1s;
    proxy_read_timeout 3s;
    proxy_pass http://127.0.0.1:18192;
    access_log off;
}
location / { return 404; }

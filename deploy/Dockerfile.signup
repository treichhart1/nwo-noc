FROM node:22-alpine@sha256:1314fb30ec37592d5845e5a160d522c0e680972aa534549940b8d73bde88481a AS build
WORKDIR /app
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY frontend/ ./
RUN npm run build:signup
FROM nginx:1.30.8-alpine@sha256:8eb04fe3b385090e9aa02961f77398ad09b6bf33ab07f6669a5bb7acce22c0d3
RUN apk upgrade --no-cache && rm -rf /usr/share/nginx/html/* /etc/nginx/conf.d/default.conf
COPY frontend/nginx-main.conf /etc/nginx/nginx.conf
COPY examples/signup/nginx.conf /etc/nginx/conf.d/signup.conf
COPY --from=build /app/dist-signup /usr/share/nginx/html
RUN chmod 444 /etc/nginx/nginx.conf /etc/nginx/conf.d/signup.conf && chmod -R a=rX /usr/share/nginx/html
USER 101:101
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --retries=3 CMD wget -Y off -qO- http://127.0.0.1:8080/signup.html >/dev/null || exit 1

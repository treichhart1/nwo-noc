# Place only in the reviewed HTTPS nwohiobb.com public reverse proxy.
# status-gateway has ONLY app.customer_status.public_app, never app.main.
# Explicitly attach only the approved gateway/DB peers to the internal network.
location = /network-status-api/v1 {
    limit_except GET { deny all; }
    proxy_pass http://status-gateway:8002/public/network-status/v1;
    proxy_set_header Authorization "";
    proxy_set_header Cookie "";
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_connect_timeout 2s;
    proxy_read_timeout 5s;
    proxy_hide_header Set-Cookie;
    # Responses permit a maximum30-second approved-data cache. Purge on urgent withdrawal.
}
# Serve ONLY the separately built dist-status assets. Never serve the private dist/.
location /noc-status/ {
    alias /srv/nwo-public-status/;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    add_header Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; connect-src 'self'; img-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'self'; upgrade-insecure-requests" always;
}

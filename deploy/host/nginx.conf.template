server {
  listen 8080;
  listen unix:/ingress/frontend.sock__TLS__;
  server_name localhost;
  server_tokens off;
  __CERTIFICATES__
  root /usr/share/nginx/html;
  index index.html;
  client_max_body_size 16m;
  client_body_timeout 30s;
  send_timeout 60s;
  add_header X-Content-Type-Options nosniff always;
  add_header Referrer-Policy same-origin always;
  add_header X-Frame-Options DENY always;
  add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; frame-src 'none'" always;
  resolver 127.0.0.11 valid=5s ipv6=off;
  set $backend http://backend:8000;
  location ~ /\. { deny all; }
  location /api/planning/ {
    client_max_body_size 128m;
    proxy_read_timeout 120s;
    proxy_pass $backend$request_uri;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
  }
  location /api/ {
    proxy_connect_timeout 5s;
    proxy_read_timeout 120s;
    proxy_pass $backend$request_uri;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
  }
  location = /health { proxy_pass $backend/health; }
  location / { try_files $uri /index.html; }
}

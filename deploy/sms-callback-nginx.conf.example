# Fragment for a separately approved dedicated HTTPS callback vhost.
# TLS certificates, listen address, DNS, firewall and publication are operator work.
# In the enclosing http{} define:
# limit_req_zone $binary_remote_addr zone=noc_sms_callbacks:10m rate=10r/s;
# Then add these exact locations to the dedicated callback vhost.
# Never add proxy_pass to the private backend, dashboard or public-status gateway.
location = /callbacks/sms/twilio {
    limit_except POST { deny all; }
    limit_req zone=noc_sms_callbacks burst=20 nodelay;
    client_max_body_size 16k;
    client_body_timeout 5s;
    proxy_connect_timeout 2s;
    proxy_read_timeout 8s;
    proxy_pass http://127.0.0.1:18191;
    access_log off;
}
location = /callbacks/sms/telnyx {
    limit_except POST { deny all; }
    limit_req zone=noc_sms_callbacks burst=20 nodelay;
    client_max_body_size 16k;
    client_body_timeout 5s;
    proxy_connect_timeout 2s;
    proxy_read_timeout 8s;
    proxy_pass http://127.0.0.1:18191;
    access_log off;
}
location / { return 404; }

# PostgreSQL16 engine/entrypoint/data layout remain vendor-provided. Rebuild only
# the privilege-drop helper from reviewed immutable source with patched Go.
FROM golang:1.27.4-alpine@sha256:70bd7ddea8b6cbe5d6943cde279d6b67feb10cc924fb9100d1d8757c1575b280 AS gosu
ENV CGO_ENABLED=0 GOTOOLCHAIN=local
WORKDIR /src
COPY deploy/vendor/gosu/go.mod deploy/vendor/gosu/go.sum ./
RUN go mod download && go mod verify
COPY deploy/vendor/gosu/*.go ./
RUN go build -mod=readonly -trimpath -o /out/gosu . && go version -m /out/gosu

FROM postgres:16-alpine@sha256:81e77a4833487b8132fe4b00bedd39dc3f74b8641e387f19312a48f7de218c2e
COPY --from=gosu /out/gosu /usr/local/bin/gosu
COPY deploy/vendor/gosu/LICENSE /usr/local/share/licenses/noc-gosu/LICENSE
COPY --from=gosu /usr/local/go/LICENSE /usr/local/share/licenses/noc-gosu/Go-LICENSE
COPY --from=gosu /go/pkg/mod/github.com/moby/sys/user@v0.4.1/LICENSE /usr/local/share/licenses/noc-gosu/moby-user-LICENSE
COPY --from=gosu /go/pkg/mod/golang.org/x/sys@v0.44.0/LICENSE /usr/local/share/licenses/noc-gosu/xsys-LICENSE
RUN apk upgrade --no-cache && gosu nobody true && test "$(gosu postgres id -u)" = "70"
LABEL com.nwo-noc.gosu.revision="29b939aa5bd4dc588af765b8248f6e39150d2565" \
      com.nwo-noc.gosu.toolchain="go1.27.4"

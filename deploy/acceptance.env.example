# Documentation template only. Generate private values with configure.py.
APP_ENV=staging
OFFLINE_MODE=true
API_DOCS_ENABLED=false
SECRET_KEY=<generated 64 hex characters>
ADMIN_USERNAME=acceptance
ADMIN_PASSWORD=<generated 48 hex characters>
ADMIN_EMAIL=acceptance@example.invalid
POSTGRES_PASSWORD=<generated 48 hex characters>
DATABASE_URL=postgresql+psycopg://noc_test:<same generated database password>@db:5432/nwo_noc
REDIS_URL=redis://redis:6379/0
UISP_BASE_URL=
UISP_TOKEN=
UISP_VERIFY_TLS=true
RF_COLLECTION_ENABLED=false
RF_SNMP_ENABLED=false
RF_SNMP_CONFIG_FILE=
RF_HISTORY_PRUNING_ENABLED=false
CORS_ORIGINS=http://127.0.0.1:18090

# Never enable collectors or reference external secret files in acceptance.
UISP_ENABLED=false
MIKROTIK_ENABLED=false
INTEGRATIONS_ADMIN_APPROVED=false

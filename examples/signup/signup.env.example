# Disabled by default; do not add real keys to the repository.
SIGNUP_PUBLIC_ENABLED=false
SIGNUP_PUBLIC_ORIGIN=https://signup.nwohiobb.com
SIGNUP_PUBLIC_TEST_MODE=false
SIGNUP_PII_KEY_FILE=/run/signup/pii.key
SIGNUP_TURNSTILE_MODE=disabled
SIGNUP_TURNSTILE_SITE_KEY=
SIGNUP_TURNSTILE_SECRET_FILE=/run/signup/turnstile.secret
SIGNUP_TRUSTED_PROXY_CIDRS=
SIGNUP_GEOCODER=disabled
SIGNUP_GEOCODER_ORIGIN=
SIGNUP_GEOCODER_APPROVED_ORIGINS=
SIGNUP_GEOCODER_ADMIN_APPROVED=false
SIGNUP_RETENTION_DAYS=365

# Cancellation intake requires separate operator authorization and reviewed policy.
RETENTION_PUBLIC_ENABLED=false

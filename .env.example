APP_NAME="NWO NOC"
APP_ENV=production
# Keep API documentation and OpenAPI schema unpublished unless explicitly needed.
API_DOCS_ENABLED=false
SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=15

POSTGRES_DB=nwo_noc
POSTGRES_USER=nwo_noc
POSTGRES_PASSWORD=replace-database-password
DATABASE_URL=postgresql+psycopg://nwo_noc:replace-database-password@db:5432/nwo_noc
REDIS_URL=redis://redis:6379/0

ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeThisPassword123!
ADMIN_EMAIL=admin@nwohiobb.local

UISP_BASE_URL=https://10.210.0.20
UISP_TOKEN=
UISP_VERIFY_TLS=true
# Trust the UISP server certificate or configure a trusted internal CA before syncing.
# Do not disable certificate verification to work around certificate errors.
UISP_SYNC_INTERVAL_SECONDS=300

## Published ports default to localhost; access via authenticated VPN/reverse proxy.
## Review network access before overriding BIND_ADDRESS.
BIND_ADDRESS=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=8090
CORS_ORIGINS=http://localhost:8090,http://127.0.0.1:8090

# Read-only integrations remain disabled. Credentials alone NEVER activate them.
UISP_ENABLED=false
MIKROTIK_ENABLED=false
INTEGRATIONS_ADMIN_APPROVED=false
# Exact HTTPS origins, comma-separated; no paths, credentials, wildcards or redirects.
UISP_ALLOWED_ORIGINS=
MIKROTIK_BASE_URL=
MIKROTIK_ALLOWED_ORIGINS=
MIKROTIK_USERNAME=
MIKROTIK_PASSWORD=
# MIKROTIK_DEVICE_ID=<existing numeric NOC device ID>
# Optional private mode-0400/0600 regular files, instead of inline credential values.
UISP_TOKEN_FILE=
MIKROTIK_PASSWORD_FILE=

# Explicit single-device SNMPv3 RF polling, disabled and never auto-scheduled.
# Requires verified firmware/MIB mappings, exact IP allowlist and read-only view.
RF_SNMP_ENABLED=false
RF_SNMP_CONFIG_FILE=
RF_RADIO_THRESHOLDS={}

# Microwave SNMPv3 GET-only collection; scheduling is separately opt-in; remediation remains simulation-only.
RF_MICROWAVE_ENABLED=false
RF_MICROWAVE_CONFIG_FILE=
RF_MICROWAVE_THRESHOLDS={}

# Historical analytics is local/read-only. Projection and retention are explicit jobs.
RF_ANALYTICS_PROJECTION_ENABLED=false
RF_ANALYTICS_POLICY={}
RF_ANALYTICS_RETENTION_ENABLED=false
RF_ANALYTICS_RETENTION_DAYS=90
RF_ANALYTICS_RETENTION_BATCH=1000

# NOC-90 deterministic troubleshooting works without AI. Never enable for offline acceptance.
RF_EXPLANATION_PROVIDER=disabled
RF_EXPLANATION_ADMIN_APPROVED=false
RF_EXPLANATION_MODEL=local-rf
RF_TROUBLESHOOTING_TEMPERATURE_WARNING_C=80

# NOC-92 durable scheduler remains opt-in; never enable in offline acceptance except synthetic staging.
RF_SCHEDULER_ENABLED=false
RF_SCHEDULER_MANIFEST_FILE=
RF_SCHEDULER_SPOOL_DIR=/var/lib/nwo-noc/monitoring
RF_SCHEDULER_CONCURRENCY=8
RF_SCHEDULER_BATCH_SIZE=32
RF_RELIABILITY_POLICY={}

# NOC-95: synthetic customer imports only; live adapter is unavailable/fail-closed.
POWERCODE_FIXTURE_ENABLED=false
POWERCODE_LIVE_ENABLED=false

# NOC-96: offline mock processing only; no live SMS/Slack activation available.
NOTIFICATIONS_WORKER_ENABLED=false
NOTIFICATIONS_AUTO_DRAFTS_ENABLED=false
NOTIFICATIONS_LIVE_DELIVERY_ENABLED=false
NOTIFICATIONS_VAULT_KEY_FILE=
